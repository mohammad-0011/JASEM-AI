# JASEM — کلیدهای API را اینجا قرار دهید (این فایل نمونه است)
# فایل واقعی: .env   (هیچ‌وقت به گیت نمی‌رود)
# حالت آفلاین: هیچ کلیدی لازم نیست؛ جاسم با موتور محلی جواب می‌دهد.

# ------------------------------------------------------------------
# گزینهٔ ۱ (پیشنهادی، رایگان): Google AI Studio — Gemini
# کلید رایگان بسازید: https://aistudio.google.com/apikey   (بدون کارت بانکی)
# ------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# gemini-flash-lite-latest سریع و پایدار است؛ اگر ۵۰۳ گرفتید gemini-flash-latest را امتحان کنید
OPENAI_MODEL=gemini-flash-lite-latest

# ------------------------------------------------------------------
# گزینهٔ ۲ (رایگان، خیلی سریع): Groq
# کلید رایگان: https://console.groq.com/keys   (بدون کارت بانکی)
# سقف پیش‌فرض: ۳۰ درخواست/دقیقه، ۱۰۰۰ درخواست/روز
# ------------------------------------------------------------------
# OPENAI_API_KEY=gsk_...
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------
# سرویس‌های دیگر
# ------------------------------------------------------------------
# OpenAI (پولی):
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# OpenRouter (مدل‌های :free محدود روزانه):
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=qwen/qwen3-235b-a22b:free
# LM Studio / Ollama (کاملاً محلی، بدون کلید):
# OPENAI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
